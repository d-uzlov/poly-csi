
FROM debian:forky-20260918-slim AS c_builder

RUN --mount=type=cache,target=/var/cache/apt,id=apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,id=aptlib,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends --no-install-suggests \
    autoconf \
    automake \
    make \
    g++ \
    pkg-config \
    libtool \
    liburing-dev \
    git

# ========================

FROM c_builder AS builder_libiscsi

ADD --link https://github.com/sahlberg/libiscsi.git#2f568c66202cdfb8af7c8817708db8e19a9164f8 /libiscsi

WORKDIR /libiscsi

COPY ./libiscsi-str-len.patch /tmp/libiscsi-str-len.patch

# by default libiscsi silently truncates url to 255 bytes,
# which breaks shares with long domain name, long iqn, or long user/pass
# https://github.com/sahlberg/libiscsi/blob/2f568c66202cdfb8af7c8817708db8e19a9164f8/lib/init.c#L592
RUN git apply /tmp/libiscsi-str-len.patch

RUN autoreconf -i \
	&& ./configure \
	&& make -j"$(nproc)"
RUN make install DESTDIR=/install

# ========================

FROM c_builder AS builder_ublksrv

COPY --from=builder_libiscsi /install/usr/local/ /usr/local/

ADD --link https://github.com/ublk-org/ublksrv.git#e36fae3f0995c4940b9007eb10d020beaba6a7e2 /ublksrv

WORKDIR /ublksrv

COPY ./ublk-iscsi.patch /tmp/ublk-iscsi.patch

# https://github.com/ublk-org/ublksrv/issues/211
RUN git apply /tmp/ublk-iscsi.patch

RUN autoreconf -i \
	&& ./configure \
	&& make -j"$(nproc)" \
	&& make ublk.iscsi
RUN make install DESTDIR=/install && cp /ublksrv/.libs/ublk.iscsi /install/usr/local/sbin/ublk.iscsi

# ========================

FROM c_builder AS builder_nbdublk

RUN --mount=type=cache,target=/var/cache/apt,id=apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,id=aptlib,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends --no-install-suggests \
    libgnutls28-dev \
    libxml2-dev \
    ocaml

COPY --from=builder_ublksrv /install/usr/local/ /usr/local/

ADD --link https://gitlab.com/nbdkit/libnbd.git#467f548f4f78da48ae3e44ea83aeb679adb7a698 /nbdublk

WORKDIR /nbdublk

RUN autoreconf -i \
	&& ./configure \
	&& make -j"$(nproc)"
RUN make install DESTDIR=/install

# ========================

FROM golang:1.27.3-alpine3.24 AS builder_plugin

WORKDIR /app

COPY go.mod go.sum /app/

RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY ./cmd/blockplugin/ /app/cmd/blockplugin/
COPY ./pkg/ /app/pkg/

ARG APP_VERSION

# prevent building with empty version
RUN test -n "${APP_VERSION}"
RUN --mount=type=cache,target=/go/pkg/mod \
	--mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 go build -ldflags="-X meoe.io/poly-csi/cmd/blockplugin/config.externalVersion=${APP_VERSION}" ./cmd/blockplugin/

# ========================

FROM debian:forky-20260918-slim AS runtime

RUN --mount=type=cache,target=/var/cache/apt,id=apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,id=aptlib,sharing=locked \
	apt-get update \
	&& apt-get install -y --no-install-recommends --no-install-suggests \
  liburing2 \
  libstdc++6 \
  tini \
  rsyslog

COPY --from=builder_libiscsi /install/usr/local/ /usr/local/
COPY --from=builder_ublksrv /install/usr/local/ /usr/local/
COPY --from=builder_nbdublk /install/usr/local/ /usr/local/
COPY --from=builder_plugin /app/blockplugin /blockplugin

RUN ldconfig

ENTRYPOINT ["/usr/bin/tini", "-s", "--", "/blockplugin"]
