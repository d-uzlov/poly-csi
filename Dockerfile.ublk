
FROM debian:forky-20260918-slim AS c_builder

RUN --mount=type=cache,target=/var/cache/apt,id=apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,id=aptlib,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends --no-install-suggests \
    autoconf \
    automake \
    make \
    g++ \
    pkg-config \
    libtool

# ========================

FROM c_builder AS builder_libiscsi

ADD --link https://github.com/sahlberg/libiscsi.git /libiscsi

WORKDIR /libiscsi

RUN autoreconf -i \
	&& ./configure \
	&& make -j"$(nproc)"
RUN make install DESTDIR=/install

# ========================

FROM c_builder AS builder_ublk

COPY --from=builder_libiscsi /install/usr/local/ /usr/local/

RUN --mount=type=cache,target=/var/cache/apt,id=apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,id=aptlib,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends --no-install-suggests \
    liburing-dev \
    git

ADD --link https://github.com/ublk-org/ublksrv.git /ublksrv

WORKDIR /ublksrv

COPY ./ublk-iscsi.patch /tmp/ublk-iscsi.patch

# https://github.com/ublk-org/ublksrv/issues/211
RUN git apply /tmp/ublk-iscsi.patch

RUN autoreconf -i \
	&& ./configure \
	&& make -j"$(nproc)" \
	&& make ublk.iscsi
RUN make install DESTDIR=/install && cp /ublksrv/.libs/ublk.iscsi /install/usr/local/sbin/ublk.iscsi

# ========================

FROM golang:1.27.1-alpine3.23 AS builder_plugin

WORKDIR /app

COPY go.mod go.sum /app/

RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY ./cmd/builtinplugin/ /app/cmd/builtinplugin/
COPY ./pkg/ /app/pkg/

ARG APP_VERSION

# prevent building with empty version
RUN test -n "${APP_VERSION}"
RUN --mount=type=cache,target=/go/pkg/mod \
	--mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 go build -ldflags="-X meoe.io/poly-csi/cmd/builtinplugin/config.externalVersion=${APP_VERSION}" ./cmd/builtinplugin/

# ========================

FROM debian:forky-20260918-slim AS runtime

RUN --mount=type=cache,target=/var/cache/apt,id=apt,sharing=locked \
	--mount=type=cache,target=/var/lib/apt,id=aptlib,sharing=locked \
	apt-get update \
	&& apt-get install -y --no-install-recommends --no-install-suggests \
  liburing2 \
  libstdc++6 \
  tini \
  rsyslog

COPY --from=builder_libiscsi /install/usr/local/ /usr/local/
COPY --from=builder_ublk /install/usr/local/ /usr/local/
COPY --from=builder_plugin /app/builtinplugin /builtinplugin

RUN ldconfig

ENTRYPOINT ["/usr/bin/tini", "--", "/builtinplugin"]
