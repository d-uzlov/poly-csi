FROM golang:1.27.3-alpine3.24 AS builder

WORKDIR /app

COPY go.mod go.sum /app/

RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY ./cmd/blockplugin/ /app/cmd/blockplugin/
COPY ./pkg/ /app/pkg/

ARG APP_VERSION

# prevent building with empty version
RUN test -n "${APP_VERSION}"
RUN --mount=type=cache,target=/go/pkg/mod \
	--mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 go build -ldflags="-X meoe.io/poly-csi/cmd/blockplugin/config.externalVersion=${APP_VERSION}" ./cmd/blockplugin/

FROM alpine:3.24.2 AS runtime

WORKDIR /

COPY --from=builder /app/blockplugin /blockplugin

ENTRYPOINT ["/blockplugin"]
