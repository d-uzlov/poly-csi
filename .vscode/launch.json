  "version": "0.2.0",
  "configurations": [
    {
      "name": "controller",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/controller",
      "args": [
        "--config=${workspaceFolder}/config.yaml",
        // "--listen-address=unix:///tmp/poly-csi.sock"
      ]
    },
    {
      "name": "node",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/node",
      "args": [
        "--node-config=${workspaceFolder}/config-node.yaml",
        "--csi-node-id=debug",
        // "--listen-address=unix:///tmp/poly-csi.sock"
      ]
    },
    {
      "name": "config checker",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/configchecker",
      "args": [
        "--config=${workspaceFolder}/config.yaml",
        // "--listen-address=unix:///tmp/poly-csi.sock"
      ]
    }
  ]
}