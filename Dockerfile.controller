FROM golang:1.27.3-alpine3.24 AS builder

WORKDIR /app

COPY go.mod go.sum /app/

RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY ./cmd/controller/ /app/cmd/controller/
COPY ./pkg/ /app/pkg/

ARG APP_VERSION

# prevent building with empty version
RUN test -n "${APP_VERSION}"
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 go build -ldflags="-X meoe.io/poly-csi/cmd/controller/config.externalVersion=${APP_VERSION}" ./cmd/controller/

FROM scratch AS runtime
  
WORKDIR /

COPY --from=builder /app/controller /controller

ENTRYPOINT ["/controller"]
